{
  "name": "@ironbark/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "ingest": "tsx src/ingestion/cli.ts",
    "verify:ingestion": "tsx src/ingestion/verify-ingestion.ts",
    "test": "vitest run",
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.16.3",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
